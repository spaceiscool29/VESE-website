<!doctype html> //tells the browser that this is an HTML5 document so standard for any HTML page
<html lang="en"> //sets the language of the document to English
	<head> //contains metadata about the document
		<meta charset="utf-8" /> //sets the character encoding to UTF-8
		<meta name="viewport" content="width=device-width" /> //ensures the page is responsive
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" /> //links to the SVG favicon
		<link rel="icon" href="/favicon.ico" /> //links to the ICO favicon
		<meta name="generator" content={Astro.generator} /> //indicates the generator used
		<title>Astro Basics</title> //sets the title of the page
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
